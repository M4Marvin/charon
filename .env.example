# SQLite database path (relative or absolute)
DATABASE_URL="dev.db"

# Auth secret — generate with: openssl rand -hex 64
BETTER_AUTH_SECRET="replace-with-a-64-char-random-string"

# Encryption key for API keys at rest — generate with: openssl rand -hex 32
ENCRYPTION_KEY="replace-with-a-32-char-random-string"

# Public URL for auth cookies (required in production)
# APP_URL="https://my-server.example.com"

# Additional CORS origins (comma-separated, optional)
# TRUSTED_ORIGINS=""

# Logging (optional)
# LOG_LEVEL="debug"      # debug | info | warn | error
# LOG_DIR="./logs"
# LOG_FILE_ENABLED="true"
